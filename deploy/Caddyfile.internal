# HTTPS с самоподписанным сертификатом: подходит для доступа по IP или из локальной сети.
# Браузер покажет предупреждение о недоверенном сертификате — трафик при этом шифруется.
#
# Клиенты не отправляют SNI, если подключаются по IP-адресу (это требует RFC 6066).
# Без default_sni Caddy не может выбрать сертификат и рвёт handshake с internal error.
#
# HTTP/3 отключён намеренно: самоподписанному сертификату нельзя доверять в QUIC,
# и Safari после alt-svc переключается на h3, где вход падает с "Load failed".
{
	default_sni {$APP_DOMAIN}
	servers {
		protocols h1 h2
	}
}

{$APP_DOMAIN} {
	tls internal
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy web:80 {
		# nginx берёт realip из этого заголовка: иначе лимит входа считался бы на IP Caddy.
		header_up X-Real-IP {remote_host}
	}
}
