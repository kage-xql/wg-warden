# Настройки для запуска на VPS: ./deploy/vps-install.sh
# Не используйте этот файл для локального запуска (там нужен .env).

# Порт панели без домена: 80 — открывается по адресу http://<IP-VPS>; 8080 — если 80 занят.
WEB_PORT=80

DB_USER=wgwarden
DB_PASSWORD=
# openssl rand -base64 32
APP_MASTER_KEY=
# openssl rand -base64 48
JWT_SECRET=

# Одноразовый токен для создания первого аккаунта (генерируется vps-install.sh).
APP_BOOTSTRAP_TOKEN=
# false — регистрация закрыта. Первый аккаунт создаётся только по setup-токену.
# true — открыть регистрацию новых пользователей всем (не рекомендуется).
APP_REGISTRATION_ENABLED=false
# Сколько Argon2-хешей считать одновременно (ограничение памяти).
APP_PASSWORD_HASH_CONCURRENCY=2

MONITORING_INTERVAL=60s
PGDATA_VOLUME=wg-warden_vps_pgdata

# Домен панели. Заполнен — установщик поднимает Caddy с HTTPS (стек docker-compose.tls.yml),
# пусто — панель открывается по IP через HTTP (docker-compose.vps.yml).
# Для домена нужна A-запись на IP этого VPS.
# Можно указывать домен (panel.example.com), IP (203.0.113.10) или URL со схемой:
# установщик приведёт значение к нужному виду.
APP_DOMAIN=
# acme — сертификат Let's Encrypt (нужен домен); internal — самоподписанный
# сертификат для IP или локальной сети. Для APP_DOMAIN=<IP> установщик включает
# internal автоматически: Let's Encrypt не выдаёт сертификаты на IP-адреса.
TLS_MODE=acme
HTTP_PORT=80
HTTPS_PORT=443
